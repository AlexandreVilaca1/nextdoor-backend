# Copy to .env and adjust the values.
#
# SQL Server connection
DB_SERVER=localhost
DB_DATABASE=NextDoor
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=change_me
#
# Long random string used to sign and verify the JWT tokens.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SECRET_KEY=change_me
#
# HTTP port (defaults to 3000 when unset)
PORT=3000
